# syntax=docker/dockerfile:1
# The optional single-client image builds the audited subscription check into
# the same 3x-ui release as the regular control image.
FROM docker.io/library/alpine:3.22 AS source
WORKDIR /src
RUN apk add --no-cache curl patch
RUN curl -fsSL --retry 4 https://codeload.github.com/MHSanaei/3x-ui/tar.gz/c621ba9014a6aa21fd7c9ecf45655e44e24ebf13 -o /tmp/panel.tar.gz && \
    echo 'bacddae4a55df85a37a0503ed9c2c5312c01da46886a14f6b6d5134b6965c004  /tmp/panel.tar.gz' | sha256sum -c - && \
    tar xzf /tmp/panel.tar.gz --strip-components=1
COPY infra/3x-ui/*.patch /tmp/patches/
RUN for fix in /tmp/patches/*.patch; do patch -p1 < "$fix" || exit 1; done

FROM docker.io/library/node:26-alpine AS frontend
WORKDIR /src/frontend
COPY --from=source /src/frontend/package*.json ./
RUN npm ci
COPY --from=source /src/frontend/ ./
COPY --from=source /src/internal/web/translation /src/internal/web/translation
RUN npm run build

FROM docker.io/library/golang:1.27.3-bookworm AS build
WORKDIR /src
COPY --from=source /src/go.mod /src/go.sum ./
RUN go mod download
COPY --from=source /src/ ./
COPY --from=frontend /src/internal/web/dist/ ./internal/web/dist/
RUN CGO_ENABLED=1 go build -p 2 -trimpath -ldflags="-s -w" -o /x-ui main.go

FROM localhost/vless-control:dev
COPY --from=build /x-ui /app/x-ui
COPY --from=source /src/LICENSE /usr/share/doc/3x-ui/LICENSE
LABEL io.vless.single-client-subscriptions="1"
