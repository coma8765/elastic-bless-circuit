{% if node_role != 'control' %}
role: {{ node_role }}
{% endif %}
mesh:
  enabled: true
  udp_port: {{ mesh_udp_port | int }}
  server: {{ headscale_url | to_json }}
  hostname: {{ container_name | to_json }}
  auth_key_file: /run/secrets/headscale-key
{% if node_role == 'control' %}
panel_settings:
  username_file: /run/secrets/panel-user
  password_file: /run/secrets/panel-password
  port: 2053
  base_path: /
{% elif node_role == 'out' %}
listener: {address: mesh, port: {{ transit_port }}}
transit_uuid_file: /run/secrets/transit-uuid
allow_private_destinations: {{ allow_private_destinations | bool | lower }}
{% if exit_dns_servers | default([]) | length > 0 %}
dns:
  servers: {{ exit_dns_servers | to_json }}
{% endif %}
{% elif node_role == 'gateway' %}
listener: {address: mesh, port: {{ transit_port }}}
gateway:
  countries: {{ route_gateway_countries | to_json }}
  ingresses:
{% for reader in route_readers %}
    - name: {{ reader | to_json }}
      uuid_file: /run/secrets/gateway-{{ reader }}.uuid
      exits: {{ route_exits | intersect(hostvars[reader].ingress_subscription_exits or groups.exits) | sort | to_json }}
{% endfor %}
  probe_url: {{ route_gateway_probe_url | to_json }}
  probe_interval_seconds: {{ route_gateway_probe_interval_seconds }}
{% else %}
sync_seconds: {{ sync_seconds }}
max_stale_seconds: {{ max_stale_seconds }}
listener:
  address: 0.0.0.0
  port: {{ ingress_port }}
  stream:
    network: tcp
    security: {{ ingress_security }}
{% if ingress_security == 'reality' %}
    realitySettings:
      target: {{ ingress_reality_target | to_json }}
      serverNames: [{{ ingress_reality_server_name | to_json }}]
      private_key_file: /run/secrets/reality-private-key
      shortIds: [{{ hostvars[groups.headscale[0]].reality_identities[inventory_hostname].short_id | to_json }}]
      xver: 0
{% else %}
    tlsSettings:
      certificates:
        - certificateFile: /run/secrets/fullchain.pem
          keyFile: /run/secrets/privkey.pem
{% endif %}
panel:
  # HTTP is carried exclusively inside authenticated WireGuard, never public IPs.
  url: http://{{ hostvars[groups.control[0]].mesh_ip }}:2053
  allow_http: true
  username_file: /run/secrets/panel-user
  password_file: /run/secrets/panel-password
  inbound_id: {{ hostvars[groups.control[0]].panel_directory.inbound_ids[inventory_hostname] if ingress_security == 'reality' else hostvars[groups.control[0]].panel_directory.inbound_id }}
{% if ingress_route_gateway | default('') %}
auto_gateway:
  selector: {{ ingress_auto_selector }}
  address: {{ hostvars[ingress_route_gateway].mesh_ip | to_json }}
  port: {{ hostvars[ingress_route_gateway].transit_port }}
  uuid_file: /run/secrets/gateway-transit.uuid
{% endif %}
{% endif %}
{% if node_role in ['in', 'gateway'] %}
exits:
{% for peer in (route_exits if node_role == 'gateway' else groups.exits) %}
  - name: {{ peer | to_json }}
    address: {{ hostvars[peer].mesh_ip | to_json }}
    port: {{ hostvars[peer].transit_port }}
    uuid_file: /run/secrets/{{ 'exit-' + peer + '.uuid' if node_role == 'gateway' else peer + '-uuid' }}
{% endfor %}
{% endif %}
{% if node_role == 'in' %}
{% if panel_client_mode | default('grouped') == 'single' %}
single_client:
  selectors: {{ vless_route_selectors | dict2items | selectattr('key', 'in', ingress_subscription_exits | default([]) or groups.exits) | list | items2dict | to_json }}
  legacy: {{ hostvars[groups.headscale[0]].single_client_legacy.owners | to_json }}
{% else %}
routes:
{% for user in hostvars[groups.headscale[0]].managed_users %}
  {{ user.email | to_json }}: {{ user.exit | to_json }}
{% endfor %}
{% endif %}
{% endif %}
