# Managed by vless external-edge; do not share this file with other services.
map $http_upgrade $vless_edge_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    listen [::]:80;
    server_name {{ external_edge_domain }};
    access_log off;
    location = /generate_204 { return 204; }
    location / { return 301 https://{{ external_edge_domain }}$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ external_edge_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ edge_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ edge_cert_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # All paths may include subscription/authentication material.
    access_log off;
    error_log /var/log/nginx/vless-edge-error.log crit;
    location ^~ /sub/ {
        proxy_pass http://{{ edge_sub_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header True-Client-IP $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header CF-Connecting-IP "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location / {
        proxy_pass http://{{ edge_headscale_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vless_edge_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header True-Client-IP $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
