{
  "tagOwners": {"tag:in": [], "tag:out": [], "tag:control": []{% if groups.get('route_gateways', []) %}, "tag:route-gateway": []{% endif %}},
  "acls": [
    {"action": "accept", "src": ["tag:in"], "dst": [{% for port in groups.exits | map('extract', hostvars, 'transit_port') | unique %}"tag:out:{{ port }}"{% if not loop.last %}, {% endif %}{% endfor %}], "proto": "tcp"},
{% if groups.get('route_gateways', []) %}
    {"action": "accept", "src": ["tag:in"], "dst": [{% for port in groups.route_gateways | map('extract', hostvars, 'transit_port') | unique %}"tag:route-gateway:{{ port }}"{% if not loop.last %}, {% endif %}{% endfor %}], "proto": "tcp"},
    {"action": "accept", "src": ["tag:route-gateway"], "dst": [{% for port in groups.exits | map('extract', hostvars, 'transit_port') | unique %}"tag:out:{{ port }}"{% if not loop.last %}, {% endif %}{% endfor %}], "proto": "tcp"},
{% endif %}
    {"action": "accept", "src": ["tag:in"], "dst": ["tag:control:2053"], "proto": "tcp"}
  ]
}
