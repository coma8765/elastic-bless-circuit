server_url: {{ headscale_url | to_json }}
listen_addr: 0.0.0.0:{{ 8080 if (headscale_external_tls | bool) else 443 }}
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 127.0.0.1:50443
noise:
  private_key_path: /var/lib/headscale/noise.key
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential
derp:
  urls: [https://controlplane.tailscale.com/derpmap/default]
  auto_update_enabled: true
  update_frequency: 24h
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
dns:
  magic_dns: false
  base_domain: mesh.internal
  nameservers:
    global: [1.1.1.1]
policy:
  mode: file
  path: /etc/headscale/policy.json
log:
  level: warn
disable_check_updates: true
unix_socket: /var/run/headscale/headscale.sock
tls_cert_path: {{ '""' if (headscale_external_tls | bool) else '/etc/headscale/cert.pem' }}
tls_key_path: {{ '""' if (headscale_external_tls | bool) else '/etc/headscale/key.pem' }}
